{
  "name": "postcss-themed",
  "version": "2.8.1",
  "description": "PostCSS plugin for adding multiple themes to CSS files",
  "keywords": [
    "postcss",
    "css",
    "postcss-plugin",
    "theme"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "unbuild",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "lint": "eslint src/**/*.ts --no-ignore",
    "lint:fix": "pnpm lint --fix",
    "release": "auto shipit"
  },
  "author": "Tyler Krupicka <5761061+tylerkrupicka@users.noreply.github.com>",
  "license": "MIT",
  "repository": "https://github.com/intuit/postcss-themed",
  "bugs": {
    "url": "https://github.com/intuit/postcss-themed/issues"
  },
  "homepage": "https://github.com/intuit/postcss-themed",
  "dependencies": {
    "cssesc": "^3.0.0",
    "debug": "^4.3.5",
    "deepmerge": "^3.3.0",
    "dlv": "^1.1.3",
    "dset": "^3.1.3",
    "esbuild": "^0.23.0",
    "immer": "^10.1.1",
    "loader-utils": "^1.4.2"
  },
  "devDependencies": {
    "@auto-it/all-contributors": "^7.17.0",
    "@eslint/js": "^9.7.0",
    "@types/cssesc": "^3.0.2",
    "@types/debug": "^4.1.12",
    "@types/dlv": "^1.1.4",
    "@types/eslint__js": "^8.42.3",
    "@types/loader-utils": "^1.1.9",
    "@types/postcss-nested": "^4.2.3",
    "@types/webpack": "^4.41.38",
    "all-contributors-cli": "^6.26.1",
    "auto": "^7.17.0",
    "eslint": "^8.57.0",
    "eslint-plugin-unicorn": "^51.0.1",
    "postcss": "^8.4.39",
    "postcss-nested": "^4.2.3",
    "prettier": "^3.3.3",
    "simple-git-hooks": "2.11.1",
    "tsup": "^8.2.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^7.17.0",
    "unbuild": "^2.0.0",
    "vitest": "^1.6.0"
  },
  "peerDependencies": {
    "postcss": "^8.0.0"
  },
  "auto": {
    "plugins": [
      "npm",
      "released",
      "all-contributors"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,json,css,md}": [
      "prettier --write"
    ]
  },
  "volta": {
    "node": "20.15.1",
    "pnpm": "9.6.0"
  },
  "packageManager": "pnpm@9.6.0+sha512.38dc6fba8dba35b39340b9700112c2fe1e12f10b17134715a4aa98ccf7bb035e76fd981cf0bb384dfa98f8d6af5481c2bef2f4266a24bfa20c34eb7147ce0b5e"
}
