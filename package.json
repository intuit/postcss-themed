{
  "name": "postcss-themed",
  "version": "2.8.1",
  "main": "dist/index.js",
  "type": "module",
  "description": "PostCSS plugin for adding multiple themes to CSS files",
  "keywords": [
    "postcss",
    "css",
    "postcss-plugin",
    "theme"
  ],
  "scripts": {
    "build": "tsc -P tsconfig.build.json",
    "test": "vitest --run --typecheck",
    "lint": "eslint src/**/*.ts --no-ignore",
    "lint:fix": "yarn lint --fix",
    "release": "auto shipit"
  },
  "author": "Tyler Krupicka <tylerkrupicka@gmail.com>",
  "license": "MIT",
  "repository": "https://github.com/intuit/postcss-themed",
  "bugs": {
    "url": "https://github.com/intuit/postcss-themed/issues"
  },
  "homepage": "https://github.com/intuit/postcss-themed",
  "dependencies": {
    "browserslist": "^4.23.0",
    "caniuse-api": "^3.0.0",
    "cssesc": "^3.0.0",
    "debug": "^4.1.1",
    "deepmerge": "^3.2.0",
    "dlv": "^1.1.3",
    "dset": "^3.1.0",
    "flat": "^5.0.2",
    "loader-utils": "^1.2.3",
    "postcss": "^7.0.14",
    "ts-node": "^8.0.3"
  },
  "devDependencies": {
    "@auto-it/all-contributors": "^7.2.2",
    "@babel/core": "^7.6.2",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.12.1",
    "@babel/preset-env": "^7.4.3",
    "@babel/preset-typescript": "^7.7.7",
    "@types/browserslist": "^4.4.0",
    "@types/caniuse-api": "^3.0.0",
    "@types/cssesc": "^3.0.0",
    "@types/debug": "^4.1.5",
    "@types/dlv": "^1.1.2",
    "@types/flat": "^5.0.1",
    "@types/loader-utils": "^1.1.3",
    "@types/postcss-nested": "^4.1.0",
    "@types/webpack": "^4.39.2",
    "all-contributors-cli": "^6.9.1",
    "auto": "^7.2.2",
    "eslint": "^8.57.0",
    "eslint-plugin-unicorn": "^51.0.1",
    "husky": "^1.3.1",
    "lint-staged": "^8.1.5",
    "oxlint": "^0.2.11",
    "postcss-nested": "^4.1.2",
    "prettier": "^3.2.5",
    "tapable": "^1.1.3",
    "typescript": "^5.3.3",
    "typescript-eslint": "^7.1.0",
    "vitest": "^1.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "test-component-themes",
      "test-modern-themes",
      "test-utils"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts"
    ]
  },
  "engines": {
    "node": ">=7.5.0"
  },
  "auto": {
    "plugins": [
      "npm",
      "released",
      "all-contributors"
    ]
  },
  "prettier": {
    "singleQuote": true
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,json,css,md}": [
      "prettier --write",
      "git add"
    ]
  },
  "volta": {
    "node": "18.19.1"
  }
}
